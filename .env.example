# ----------------------------------------------------------------------------
# Drillpin settings. Copy this file to ".env" and fill in the values.
# On Vercel, add the same names under Project → Settings → Environment Variables.
# ----------------------------------------------------------------------------

# REQUIRED — the PostgreSQL database (e.g. from https://neon.tech).
# Use the connection string WITHOUT "-pooler" in the host name.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# The address of the site. Locally: http://localhost:3000
# On Vercel: your site's address, e.g. https://drillpin.app
APP_URL="http://localhost:3000"

# OPTIONAL — "Continue with Google" (see README). Leave empty to hide the button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OPTIONAL — sending e-mails (invitations, password reset) via https://resend.com.
# Without it, e-mails are printed in the terminal / Vercel logs instead.
RESEND_API_KEY=""
EMAIL_FROM="Drillpin <onboarding@resend.dev>"

# Set to "false" to skip the demo accounts and demo team when setting up the database.
SEED_DEMO="true"
